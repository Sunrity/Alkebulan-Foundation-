# SMTP server settings (keep credentials server-side)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Alkebulan Foundation <no-reply@example.com>"

# Public URL where the React app is deployed
FRONTEND_URL=https://alkebulanimpact.org
